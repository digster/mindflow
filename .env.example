# MindFlow environment template.
# Copy to `.env` and fill in. Every value here is baked into the built index.html
# at build time, so treat this as public configuration, not as secrets.
#
#   cp .env.example .env
#
# All values are optional — MindFlow runs fully offline without any of them.

# ---------------------------------------------------------------------------
# Google Drive integration (optional)
# ---------------------------------------------------------------------------
# OAuth 2.0 Client ID for a "Web application" client, from
# https://console.cloud.google.com/apis/credentials
#
# A Client ID is NOT a secret — it ships in the client bundle by design. The
# security boundary is the "Authorized JavaScript origins" list on the client,
# which must contain the exact origin you serve MindFlow from, e.g.
#   https://<your-username>.github.io
#   http://localhost:8000          (for `npm run serve`)
#
# Users can also paste their own Client ID into MindFlow's settings dialog at
# runtime, which overrides this build-time value. That lets someone fork and
# deploy MindFlow without rebuilding.
#
# NOTE: Drive cannot work from a file:// page — a double-clicked file reports
# its origin as `null`, which Google will not accept. Drive is HTTP(S)-only.
MINDFLOW_GOOGLE_CLIENT_ID=

# The only OAuth scope MindFlow requests. Google classifies this as
# NON-SENSITIVE: it grants per-file access to files this app itself created,
# and nothing else. Do not widen this without a very good reason — broader
# Drive scopes are "restricted" and trigger Google's verification review.
MINDFLOW_GOOGLE_SCOPE=https://www.googleapis.com/auth/drive.file

# Name of the folder MindFlow creates in the user's Drive on first connect.
MINDFLOW_DRIVE_FOLDER_NAME=MindFlow
